# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://qnskxioqsgnkkuyalqcn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy anon JWT (optional if publishable key is set)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Direct Postgres (migrations) — prefer Session pooler from Dashboard → Connect
SESSION_POOLER_URL=postgresql://postgres.qnskxioqsgnkkuyalqcn:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.qnskxioqsgnkkuyalqcn.supabase.co:5432/postgres

# Claude (Mak + output generation)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (activity classification) — optional; keyword fallback if omitted
OPENAI_API_KEY=sk-...

# Stripe (Premium subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# App URL — production: https://www.fiscmak.com | local dev: http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=https://www.fiscmak.com

# MedHub live sync (optional — CSV import always works)
# MEDHUB_API_URL=https://your-medhub-bridge.example.com
# MEDHUB_API_KEY=your-medhub-bearer-token
# NARRATIVE_SYNTHESIS_LLM=false

# Force client localStorage demo fallbacks even when Supabase is configured
# NEXT_PUBLIC_DEMO_MODE=true

# Local/staging QA test profile battery (scripts/seed-test-profile-battery.mjs — never production)
# FISCMAK_TEST_PASSWORD=
# Show username-only demo login (demo1–demo10) on /login
# NEXT_PUBLIC_FISCMAK_DEMO_LOGIN=true

# Job feed sync (cron) — POST /api/v1/jobs/sync with Authorization: Bearer $CRON_SECRET
CRON_SECRET=your-cron-secret
# INDEED_PUBLISHER_KEY= (optional, for live Indeed partner feed)

# Email notifications (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Coach Mak <notifications@yourdomain.com>
# CONTACT_INBOX_EMAIL=FISCMAK@outlook.com

# MemPalace external service (optional)
# MEMPALACE_API_URL=https://mempalace.example.com/api
# MEMPALACE_API_KEY=
